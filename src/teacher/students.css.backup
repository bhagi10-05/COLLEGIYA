.teacher-students-page {
  padding: 30px;
  max-width: 1450px;
  margin: auto;
  color: #172033;
}

.students-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.students-eyebrow {
  color: #6758e8;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.students-header h1 {
  margin: 7px 0;
  font-size: 34px;
}

.students-header p {
  margin: 0;
  color: #778197;
}

.students-header-btn {
  text-decoration: none;
  padding: 12px 19px;
  border-radius: 11px;
  background: #eeeaff;
  color: #6555dc;
  font-weight: 800;
}

.students-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 22px;
}

.student-stat-card {
  background: white;
  border: 1px solid #e8ecf3;
  border-radius: 18px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 7px 24px rgba(30, 40, 70, .05);
}

.student-stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-weight: 900;
}

.student-stat-icon.purple {
  background: #eeeaff;
  color: #6758e8;
}

.student-stat-icon.green {
  background: #e7faf0;
  color: #169b5e;
}

.student-stat-icon.blue {
  background: #e8f4ff;
  color: #2588df;
}

.student-stat-icon.orange {
  background: #fff3df;
  color: #d58a16;
}

.student-stat-card span {
  display: block;
  color: #7a8395;
  font-size: 13px;
  margin-bottom: 4px;
}

.student-stat-card strong {
  font-size: 24px;
}

.students-toolbar {
  background: white;
  border: 1px solid #e8ecf3;
  border-radius: 18px;
  padding: 14px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.students-search {
  display: flex;
  align-items: center;
  gap: 9px;
  background: #f6f7fb;
  border-radius: 11px;
  padding: 0 14px;
  flex: 1;
  max-width: 520px;
}

.students-search span {
  color: #7a8395;
  font-size: 22px;
}

.students-search input {
  border: 0;
  outline: 0;
  background: transparent;
  width: 100%;
  padding: 13px 0;
}

.students-filters {
  display: flex;
  gap: 8px;
}

.students-filters button {
  border: 1px solid #e0e5ee;
  background: white;
  color: #6e778b;
  padding: 9px 15px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 700;
}

.students-filters button.active {
  background: #6758e8;
  color: white;
  border-color: #6758e8;
}

.students-card {
  background: white;
  border: 1px solid #e8ecf3;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(30, 40, 70, .04);
}

.students-card-top {
  padding: 22px 22px 17px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #edf0f5;
}

.students-card-top h2 {
  margin: 0 0 5px;
  font-size: 20px;
}

.students-card-top p {
  margin: 0;
  color: #8991a2;
  font-size: 13px;
}

.student-table-label {
  color: #8991a2;
  font-size: 12px;
  font-weight: 700;
}

.students-table-wrap {
  overflow-x: auto;
}

.students-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 900px;
}

.students-table th {
  text-align: left;
  padding: 15px 20px;
  background: #fafbfc;
  color: #788196;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.students-table td {
  padding: 17px 20px;
  border-top: 1px solid #eef1f5;
  vertical-align: middle;
}

.student-profile-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.student-avatar {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  background: #eeeaff;
  color: #6758e8;
  display: grid;
  place-items: center;
  font-weight: 900;
}

.student-profile-cell strong {
  display: block;
  font-size: 14px;
  margin-bottom: 4px;
}

.student-profile-cell span {
  color: #8991a2;
  font-size: 12px;
}

.student-course {
  color: #455066;
  font-size: 13px;
  font-weight: 700;
}

.progress-cell {
  width: 140px;
}

.progress-top {
  text-align: right;
  font-size: 12px;
  font-weight: 800;
  margin-bottom: 5px;
}

.progress-bar {
  height: 7px;
  background: #edf0f5;
  border-radius: 10px;
  overflow: hidden;
}

.progress-bar div {
  height: 100%;
  background: linear-gradient(90deg, #6758e8, #8d72f5);
  border-radius: inherit;
}

.student-status {
  display: inline-block;
  padding: 6px 10px;
  background: #e8faf0;
  color: #15975a;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 900;
}

.joined-date {
  color: #778197;
  font-size: 12px;
}

.student-view-btn {
  border: 1px solid #ddd8ff;
  background: #f5f2ff;
  color: #6758e8;
  padding: 8px 13px;
  border-radius: 9px;
  font-weight: 800;
  cursor: pointer;
}

.students-empty {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #7d8698;
}

.students-empty > div {
  width: 65px;
  height: 65px;
  border-radius: 20px;
  background: #eeeaff;
  color: #6758e8;
  display: grid;
  place-items: center;
  font-size: 25px;
}

.students-empty h3 {
  color: #30394b;
  margin: 15px 0 5px;
}

.students-empty p {
  margin: 0;
}

.students-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 24px;
  color: #8991a2;
  font-size: 13px;
}

.students-bottom a {
  color: #6758e8;
  text-decoration: none;
  font-weight: 800;
}

.student-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(16, 20, 35, .58);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.student-modal {
  width: min(570px, 100%);
  background: white;
  border-radius: 22px;
  padding: 25px;
  position: relative;
  box-shadow: 0 25px 80px rgba(0, 0, 0, .25);
}

.student-modal-close {
  position: absolute;
  right: 20px;
  top: 20px;
  width: 37px;
  height: 37px;
  border: 0;
  border-radius: 10px;
  background: #f3f4f7;
  font-size: 23px;
  cursor: pointer;
}

.student-modal-profile {
  display: flex;
  align-items: center;
  gap: 15px;
  padding-right: 45px;
}

.student-modal-avatar {
  width: 62px;
  height: 62px;
  border-radius: 18px;
  background: #eeeaff;
  color: #6758e8;
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: 900;
}

.student-modal-profile span {
  color: #6758e8;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}

.student-modal-profile h2 {
  margin: 4px 0;
}

.student-modal-profile p {
  margin: 0;
  color: #8991a2;
  font-size: 13px;
}

.student-details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 25px 0;
}

.student-details-grid > div {
  padding: 15px;
  background: #f8f9fc;
  border-radius: 13px;
}

.student-details-grid span {
  display: block;
  color: #8991a2;
  font-size: 11px;
  margin-bottom: 6px;
}

.student-details-grid strong {
  font-size: 13px;
}

.student-modal-progress {
  margin-bottom: 22px;
}

.student-modal-progress > div:first-child {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 13px;
}

.progress-bar.large {
  height: 9px;
}

.student-modal-action {
  width: 100%;
  border: 0;
  background: #6758e8;
  color: white;
  padding: 12px;
  border-radius: 11px;
  font-weight: 800;
  cursor: pointer;
}

@media (max-width: 900px) {
  .students-stats {
    grid-template-columns: 1fr 1fr;
  }

  .students-toolbar {
    flex-direction: column;
  }

  .students-search {
    max-width: none;
  }
}

@media (max-width: 600px) {
  .teacher-students-page {
    padding: 18px;
  }

  .students-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .students-header-btn {
    width: 100%;
    text-align: center;
    box-sizing: border-box;
  }

  .students-stats {
    grid-template-columns: 1fr 1fr;
  }

  .student-stat-card {
    padding: 14px;
  }

  .student-stat-icon {
    width: 40px;
    height: 40px;
  }

  .students-card-top {
    align-items: flex-start;
  }

  .student-table-label {
    display: none;
  }

  .students-bottom {
    flex-direction: column;
    gap: 10px;
  }

  .student-details-grid {
    grid-template-columns: 1fr;
  }
}

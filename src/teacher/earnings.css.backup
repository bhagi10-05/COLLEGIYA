.earnings-page {
  padding: 28px;
  max-width: 1500px;
  margin: 0 auto;
}

.earnings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  gap: 20px;
}

.earnings-label {
  color: #5b5cf0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.earnings-header h1 {
  margin: 6px 0;
  font-size: 32px;
  color: #202035;
}

.earnings-header p {
  margin: 0;
  color: #858697;
}

.earnings-payout-button {
  border: 0;
  padding: 13px 20px;
  border-radius: 11px;
  background: #5b5cf0;
  color: white;
  font-weight: 800;
  cursor: pointer;
}

.earnings-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}

.earnings-stat {
  background: white;
  border: 1px solid #e8e8ef;
  border-radius: 17px;
  padding: 20px;
  display: flex;
  gap: 14px;
  align-items: center;
}

.stat-icon {
  width: 47px;
  height: 47px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 20px;
}

.purple .stat-icon {
  background: #eeedff;
  color: #5b5cf0;
}

.green .stat-icon {
  background: #e8f8ef;
  color: #15803d;
}

.orange .stat-icon {
  background: #fff2dc;
  color: #c56d08;
}

.blue .stat-icon {
  background: #e7f2ff;
  color: #1670c5;
}

.earnings-stat span,
.earnings-stat small {
  display: block;
}

.earnings-stat span {
  color: #77788a;
  font-size: 12px;
}

.earnings-stat strong {
  display: block;
  color: #202035;
  font-size: 23px;
  margin: 4px 0;
}

.earnings-stat small {
  color: #a0a1ad;
  font-size: 10px;
}

.earnings-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 22px;
}

.earnings-card,
.course-earnings {
  background: white;
  border: 1px solid #e8e8ef;
  border-radius: 18px;
}

.earnings-card {
  padding: 22px;
}

.earnings-card-header h2,
.course-earnings h2 {
  margin: 0;
  color: #242438;
  font-size: 19px;
}

.earnings-card-header p {
  color: #898a9a;
  font-size: 12px;
  margin: 6px 0 20px;
}

.earnings-controls {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.earnings-controls > input {
  flex: 1;
  max-width: 430px;
  border: 1px solid #e3e3eb;
  border-radius: 10px;
  padding: 12px;
  outline: none;
  font-size: 13px;
}

.earnings-filter {
  display: flex;
  gap: 6px;
}

.earnings-filter button {
  border: 1px solid #e2e2ea;
  background: white;
  padding: 9px 14px;
  border-radius: 9px;
  cursor: pointer;
  color: #68697b;
  font-weight: 700;
}

.earnings-filter button.active {
  background: #5b5cf0;
  color: white;
  border-color: #5b5cf0;
}

.transactions {
  border-top: 1px solid #ededf2;
}

.transaction {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 90px 100px;
  align-items: center;
  gap: 15px;
  padding: 16px 3px;
  border-bottom: 1px solid #ededf2;
}

.transaction-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.transaction-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border-radius: 12px;
  background: #efeeff;
  color: #5b5cf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.transaction h3 {
  margin: 0;
  color: #303044;
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.transaction p {
  margin: 5px 0 0;
  color: #999aaa;
  font-size: 10px;
}

.status {
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 800;
}

.status.paid {
  background: #e8f8ef;
  color: #15803d;
}

.status.pending {
  background: #fff2dc;
  color: #c56d08;
}

.transaction-money {
  text-align: right;
  font-weight: 800;
  color: #28283c;
  font-size: 14px;
}

.earnings-sidebar {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.balance-card {
  padding: 23px;
  border-radius: 18px;
  background: #242449;
  color: white;
}

.balance-card > span {
  font-size: 10px;
  letter-spacing: 1px;
  opacity: .65;
}

.balance-card h2 {
  font-size: 31px;
  margin: 18px 0 8px;
}

.balance-card p {
  color: #c4c4d5;
  font-size: 11px;
  line-height: 1.6;
}

.balance-card button {
  width: 100%;
  border: 0;
  border-radius: 10px;
  padding: 12px;
  background: white;
  color: #252549;
  font-weight: 800;
  cursor: pointer;
}

.course-earnings {
  padding: 21px;
}

.course-earnings h2 {
  margin-bottom: 20px;
}

.course-item {
  margin-bottom: 18px;
}

.course-item > div:first-child {
  display: flex;
  justify-content: space-between;
  margin-bottom: 7px;
}

.course-item span {
  color: #68697b;
  font-size: 11px;
}

.course-item strong {
  color: #29293d;
  font-size: 11px;
}

.course-bar {
  height: 6px;
  background: #ededf3;
  border-radius: 20px;
  overflow: hidden;
}

.course-bar i {
  display: block;
  height: 100%;
  background: #5b5cf0;
  border-radius: 20px;
}

.empty-earnings {
  text-align: center;
  padding: 60px 20px;
}

.empty-earnings > div {
  width: 55px;
  height: 55px;
  margin: auto;
  border-radius: 15px;
  background: #efeeff;
  color: #5b5cf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 22px;
}

.empty-earnings h3 {
  margin: 13px 0 5px;
  color: #303044;
}

.empty-earnings p {
  margin: 0;
  color: #999aaa;
  font-size: 12px;
}

.payout-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(10,10,25,.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.payout-modal {
  width: min(460px, 100%);
  background: white;
  border-radius: 20px;
  padding: 27px;
  position: relative;
}

.close-payout {
  position: absolute;
  right: 15px;
  top: 13px;
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 50%;
  background: #f1f1f5;
  font-size: 21px;
  cursor: pointer;
}

.payout-icon {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: #efeeff;
  color: #5b5cf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 21px;
}

.payout-modal h2 {
  margin: 15px 0 6px;
  color: #222236;
}

.payout-modal p {
  color: #88899a;
  font-size: 12px;
}

.payout-modal label {
  display: block;
  margin: 13px 0 6px;
  color: #444558;
  font-size: 11px;
  font-weight: 800;
}

.payout-modal input,
.payout-modal select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dedee7;
  border-radius: 10px;
  padding: 12px;
  outline: none;
}

.submit-payout {
  width: 100%;
  border: 0;
  margin-top: 18px;
  padding: 13px;
  border-radius: 10px;
  background: #5b5cf0;
  color: white;
  font-weight: 800;
  cursor: pointer;
}

.payout-modal small {
  display: block;
  color: #999aaa;
  font-size: 9px;
  line-height: 1.5;
  margin-top: 13px;
}

@media (max-width: 1100px) {
  .earnings-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .earnings-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .earnings-page {
    padding: 16px;
  }

  .earnings-header {
    flex-direction: column;
    align-items: stretch;
  }

  .earnings-payout-button {
    width: 100%;
  }

  .earnings-stats {
    grid-template-columns: 1fr;
  }

  .earnings-controls {
    flex-direction: column;
  }

  .earnings-controls > input {
    max-width: none;
  }

  .earnings-filter {
    width: 100%;
  }

  .earnings-filter button {
    flex: 1;
  }

  .transaction {
    grid-template-columns: 1fr;
  }

  .transaction-money {
    text-align: left;
    padding-left: 54px;
  }
}
